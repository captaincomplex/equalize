#!/bin/bash
# equalize-panel -- decides whether Equalize or Spotipi Photo drives the LED panel.
#
# Only one program can drive the panel at a time. When Spotipi Photo is
# installed on the same Pi, this hands the panel between the two:
#
#   equalize-panel airplay-start   AirPlay music started   (run by shairport-sync)
#   equalize-panel airplay-stop    AirPlay quiet for 10 s  (run by shairport-sync)
#                                  (spotify_watch.py does the same two for Spotify Connect)
#   equalize-panel boot            at start-up             (equalize-panel.service)
#   equalize-panel use auto|equalize|spotipi               (the web panel)
#   equalize-panel status          which one has the panel
#
# The choice ("panel_share" in Equalize's state.json) decides what happens:
#   auto      Equalize while AirPlay plays, Spotipi Photo the rest of the time
#   equalize  always Equalize
#   spotipi   always Spotipi Photo
#
# Without Spotipi Photo installed, Equalize simply always has the panel.
# install_pi.sh copies this to /usr/local/bin and fills in the state path.
set -u

STATE="${EQUALIZE_STATE:-@STATE_PATH@}"
SYSTEMCTL="${SYSTEMCTL:-systemctl}"
SPOTIPI_UNIT="${SPOTIPI_UNIT_FILE:-/etc/systemd/system/spotipi.service}"
LOCK="${EQUALIZE_PANEL_LOCK:-/run/equalize-panel.lock}"

share_mode() {
  python3 - "$STATE" <<'PY' 2>/dev/null || echo auto
import json, sys
try:
    mode = json.load(open(sys.argv[1])).get("panel_share", "auto")
except Exception:
    mode = "auto"
print(mode if mode in ("auto", "equalize", "spotipi") else "auto")
PY
}

# Equalize's own display mode. "Off" means don't take the panel at all:
# taking it only to show nothing would blank Spotipi Photo's pictures.
equalize_off() {
  python3 - "$STATE" <<'PY' 2>/dev/null
import json, sys
try:
    sys.exit(0 if json.load(open(sys.argv[1])).get("mode") == "off" else 1)
except Exception:
    sys.exit(1)
PY
}

have_spotipi() { [ -e "$SPOTIPI_UNIT" ]; }

# Every decision goes in the system log, with why:
#   journalctl -t equalize-panel -n 30
say() { logger -t equalize-panel "$*" 2>/dev/null || true; }

# Stop the other one first, so the two never drive the panel together.
# (equalize.service also declares Conflicts=spotipi.service as a safety net.)
show_equalize() { $SYSTEMCTL stop spotipi.service 2>/dev/null; $SYSTEMCTL start equalize.service; }
show_spotipi()  { $SYSTEMCTL stop equalize.service 2>/dev/null; $SYSTEMCTL start spotipi.service; }

# One change at a time: AirPlay hooks and the web panel can fire together.
exec 9>"$LOCK" && flock -w 30 9

cmd="${1:-status}"
if ! have_spotipi; then
  case "$cmd" in
    boot|use) $SYSTEMCTL start equalize.service ;;
    status)   echo "equalize (Spotipi Photo not installed)" ;;
  esac
  exit 0
fi

mode="$(share_mode)"
case "$cmd" in
  airplay-start)
    if [ "$mode" != auto ]; then say "music started: no change (Sharing is set to $mode)"
    elif equalize_off; then say "music started: Spotipi Photo keeps the panel (Equalize's display is Off)"
    else say "music started: panel to Equalize"; show_equalize; fi ;;
  airplay-stop)
    if [ "$mode" != auto ]; then say "music stopped: no change (Sharing is set to $mode)"
    else say "music stopped: panel to Spotipi Photo"; show_spotipi; fi ;;
  boot)
    if [ "$mode" = equalize ]; then say "start-up: panel to Equalize (Sharing is set to Equalize)"; show_equalize
    else say "start-up: panel to Spotipi Photo (Sharing: $mode)"; show_spotipi; fi ;;
  use)
    case "${2:-auto}" in
      equalize) say "Sharing set to Equalize: panel to Equalize"; show_equalize ;;
      spotipi)  say "Sharing set to Spotipi Photo: panel to Spotipi Photo"; show_spotipi ;;
      auto)     say "Sharing set to Auto: the next music start or stop decides"
                : ;;   # Equalize also hands back by itself after a minute without music
      *)        echo "usage: equalize-panel use auto|equalize|spotipi" >&2; exit 2 ;;
    esac ;;
  status)
    if $SYSTEMCTL is-active --quiet equalize.service; then echo "equalize ($mode)";
    elif $SYSTEMCTL is-active --quiet spotipi.service; then echo "spotipi ($mode)";
    else echo "neither ($mode)"; fi ;;
  *) echo "usage: equalize-panel airplay-start|airplay-stop|boot|use MODE|status" >&2; exit 2 ;;
esac
exit 0
